# Structura Reditus researcher portal — environment variables.
# Copy to portal/.env (git-ignored) for local use, or set in the hosting secret manager.
# Every value below is a placeholder. NEVER commit a real token, key, password, or secret.

# --- Website -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev          # config.settings.prod in production
DJANGO_SECRET_KEY=change-me-from-the-secret-manager  # required in prod; must not start with "insecure-"
DJANGO_DEBUG=true                                    # dev only
PORTAL_PUBLIC_BASE_URL=http://localhost:8000
PORTAL_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_CSRF_TRUSTED_ORIGINS=http://localhost:8000
PORTAL_BEHIND_TLS_PROXY=true                         # prod: trust X-Forwarded-Proto from the TLS terminator
PORTAL_HSTS_SECONDS=31536000
PORTAL_SESSION_COOKIE_AGE=1209600
PORTAL_SUPPORT_CONTACT=library@example.org
PORTAL_LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=postgres://portal:portal-local@localhost:5432/portal
DATABASE_CONN_MAX_AGE=60
# Backups/migration access are operator concerns; see docs/PORTAL_OPERATIONS.md.

# --- Background jobs ---------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false                        # true only for single-process local experiments
PORTAL_WORKER_CONCURRENCY=2
PORTAL_JOB_LEASE_SECONDS=600
PORTAL_JOB_MAX_ATTEMPTS=6
PORTAL_JOB_TIME_LIMIT_SECONDS=900
PORTAL_RECONCILE_INTERVAL_SECONDS=120

# --- Files (object storage) --------------------------------------------------
PORTAL_STORAGE_BACKEND=filesystem                     # filesystem (dev only) | s3 (required in prod)
PORTAL_MEDIA_ROOT=./private-media                     # filesystem backend only
S3_ENDPOINT_URL=http://localhost:9000                 # blank for AWS
S3_BUCKET=portal-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_SIGNED_URL_SECONDS=300
PORTAL_UPLOAD_MAX_FILE_BYTES=52428800                 # 50 MiB
PORTAL_UPLOAD_MAX_SUBMISSION_BYTES=209715200          # 200 MiB
PORTAL_ARCHIVE_MAX_MEMBERS=200
PORTAL_ARCHIVE_MAX_EXPANDED_BYTES=209715200
PORTAL_ARCHIVE_MAX_DEPTH=3
PORTAL_EXTRACTION_TIME_BUDGET_SECONDS=120
PORTAL_URL_FETCH_MAX_BYTES=52428800
PORTAL_URL_FETCH_TIMEOUT_SECONDS=20
PORTAL_URL_FETCH_MAX_REDIRECTS=3

# --- Email -------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend   # prod: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=library@example.org                # verified sender/domain in production

# --- Registry & GitHub App ---------------------------------------------------
PORTAL_REGISTRY_REPO_PATH=..                          # clone of the research repository readable by web and worker
PORTAL_REGISTRY_DEFAULT_BRANCH=main
PORTAL_REGISTRY_REMOTE=origin
PORTAL_EVALUATION_PYTHON=                             # blank = same interpreter; may point at a separate pinned engine venv
PORTAL_GITHUB_ADAPTER=registry_bridge.github_app.GitHubAppClient   # tests/local: registry_bridge.fake_github.FakeGitHubClient
GITHUB_API_URL=https://api.github.com
GITHUB_REPO_OWNER=ClementPaulus
GITHUB_REPO_NAME=SR-Research-Library                  # use the dedicated staging repository in staging
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem   # or GITHUB_APP_PRIVATE_KEY with the PEM text (secret manager)
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_REQUIRED_CHECK=validate                        # the emitted check name from .github/workflows/validate.yml
GITHUB_MERGE_METHOD=squash                            # compatible with linear-history rules
PORTAL_AUTO_MERGE_ROUTINE=true

# --- Account ownership -------------------------------------------------------
PORTAL_ADMIN_BOOTSTRAP_EMAIL=                         # explicit administrator bootstrap; never the first registrant

# --- Extraction --------------------------------------------------------------
PORTAL_EXTRACTION_MODEL_SERVICE_URL=                  # optional server-side model service; blank = deterministic parsers only
PORTAL_EXTRACTION_MODEL_VERSION=
