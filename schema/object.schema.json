{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SR-SCHEMA.v0.1.0/object.schema.json",
  "title": "Structura Reditus Tier-2 Object Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "title",
    "authors",
    "authority",
    "tier2_class",
    "functional_locus",
    "source_ids",
    "lens",
    "domain",
    "object_of_study",
    "structural_focus",
    "main_question",
    "secondary_questions",
    "claim_layers",
    "evidence_mode",
    "provenance",
    "maturity",
    "relations",
    "version",
    "date",
    "publication_state",
    "source_boundary",
    "authority_boundary",
    "scope",
    "exclusions",
    "preserved_meaning",
    "missingness",
    "distortion_or_substitution_risk",
    "next_burden",
    "repair_route",
    "notes"
  ],
  "properties": {
    "object_id": { "type": "string", "pattern": "^SR-OBJ-[0-9]{6}$" },
    "title": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["author_id", "contribution_role"],
        "properties": {
          "author_id": { "type": "string", "pattern": "^AUTH-[0-9]{4}$" },
          "contribution_role": { "type": "string" },
          "contribution_share": { "type": ["number", "string"] }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": ["tier"],
      "properties": { "tier": { "type": "integer", "const": 2 } }
    },
    "tier2_class": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "functional_locus": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_ids": { "type": "array", "items": { "type": "string", "pattern": "^SRC-[0-9]{6}$" } },
    "lens": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "domain": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "object_of_study": { "type": "string" },
    "structural_focus": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "main_question": { "type": "string", "minLength": 10 },
    "secondary_questions": { "type": "array", "items": { "type": "string" } },
    "claim_layers": { "type": "array", "items": { "type": "string" } },
    "evidence_mode": {
      "type": "object",
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": { "type": "string" },
    "maturity": { "type": "string" },
    "relations": { "type": "array", "items": { "type": "string", "pattern": "^REL-[0-9]{6}$" } },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "format": "date" },
    "publication_state": { "type": "string" },
    "source_boundary": { "type": "string" },
    "authority_boundary": { "type": "string" },
    "scope": { "type": "string" },
    "exclusions": { "type": "string" },
    "preserved_meaning": { "type": "string" },
    "missingness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "description"],
        "properties": {
          "class": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "distortion_or_substitution_risk": { "type": "string" },
    "next_burden": { "type": "string" },
    "repair_route": { "type": "string" },
    "notes": { "type": "string" }
  }
}
